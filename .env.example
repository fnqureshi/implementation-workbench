# Copy to .env.local only when you need process-specific overrides.
# Never put API keys or tenant passwords here; add them through the app so they stay in macOS Keychain.

WORKBENCH_SDK_ROOT=/absolute/path/to/implementation-sdk
WORKBENCH_VAULT_ROOT=/absolute/path/to/shape-vault
WORKBENCH_INSLY_CONFIG=/absolute/path/to/.insly/config.json

# Local identity and role: viewer | implementer | reviewer | admin
WORKBENCH_ACTOR_ID=your-company-id
WORKBENCH_ACTOR_NAME=Your Name
WORKBENCH_ROLE=admin

# Enable this in a shared operating model where requester and reviewer are different people.
WORKBENCH_REQUIRE_SEPARATE_REVIEW=0
